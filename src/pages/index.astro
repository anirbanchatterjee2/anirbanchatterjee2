---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AwardCard from '../components/AwardCard.astro';
import CertificateLightbox from '../components/CertificateLightbox.astro';
import { profile, seoDefaults } from '../data/profile';
import { profilePhoto } from '../data/profilePhoto';
import { getCollection } from 'astro:content';
import { personJsonLd } from '../lib/seo';

const awards = await getCollection('awards', ({ data }) => data.draft !== true);
const research = await getCollection('research', ({ data }) => data.draft !== true);
const achievementEntries = await getCollection('achievements', ({ data }) => data.draft !== true);
const posts = await getCollection('blog', ({ data }) => data.draft !== true);
const latestPosts = posts.slice(0, 3);
// Prefer awards with an uploaded certificate so the preview always shows real thumbnails.
const featuredAwards = awards
  .slice()
  .sort((a, b) => {
    const cert = Number(!!b.data.certificateImage) - Number(!!a.data.certificateImage);
    if (cert !== 0) return cert;
    return Number(!!b.data.featured) - Number(!!a.data.featured);
  })
  .slice(0, 4);
const featuredResearch = research.filter((r) => r.data.featured).slice(0, 3);
const selectedAchievements = achievementEntries.filter((a) => a.data.featured).slice(0, 3);
const jsonLd = [personJsonLd()];
---
<BaseLayout title={seoDefaults.title} description={seoDefaults.description} path="/" jsonLd={jsonLd}>
  <!-- Section 1: Hero with Photograph -->
  <section aria-label="Hero" style="padding: 6rem 0 4rem 0; max-width: 1152px; margin: 0 auto; position: relative;">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">
      <div style="max-width: 600px;">
        <p class="eyebrow" style="margin-bottom: 1rem;">Engineering Leader · Software Architect · Technology Researcher</p>
        <h1 class="hero-serif" style="font-size: 3.5rem; margin: 0 0 1.25rem 0; line-height: 1.1;">Anirban Chatterjee</h1>
        <p class="hero-serif" style="font-size: 1.25rem; color: var(--color-text-secondary); margin: 0 0 1.5rem 0; line-height: 1.6;">Building scalable enterprise systems, leading engineering transformation, and exploring the next generation of AI-native software.</p>
        <div style="display: flex; gap: 1rem; margin-bottom: 2rem;">
          <p style="font-size: 0.95rem; color: var(--color-text-secondary); margin: 0; line-height: 1.6;"><strong>18+ years</strong> of engineering experience across enterprise architecture, engineering leadership, and AI-native systems — including professional experience in the United States.</p>
        </div>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <a href="/experience" class="btn btn-primary" style="padding: 0.875rem 1.75rem;">Explore My Work</a>
          <a href={profile.resumePdfPath} download class="btn btn-secondary" style="padding: 0.875rem 1.75rem;">Download Resume</a>
        </div>
        <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" style="display: flex; align-items: center; gap: 0.5rem; color: var(--color-text-secondary); text-decoration: none; font-size: 0.9rem;">LinkedIn ↗</a>
          <a href={profile.github} target="_blank" rel="noopener noreferrer" style="display: flex; align-items: center; gap: 0.5rem; color: var(--color-text-secondary); text-decoration: none; font-size: 0.9rem;">GitHub ↗</a>
        </div>
      </div>
      <div style="position: relative;">
        <div style="aspect-ratio: 1; border: 1px solid var(--color-border); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-lg); position: relative;">
          {profilePhoto.src && !profilePhoto.src.includes('placeholder') ? (
            <img src={profilePhoto.src} alt={profilePhoto.alt} style="width: 100%; height: 100%; object-fit: cover;" />
          ) : (
            <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: var(--color-muted-bg); color: var(--color-text-secondary); font-size: 0.875rem;">Professional photograph — upload to public/images/profile/anirban-chatterjee.jpg</div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2: Professional Highlights -->
  <SectionHeading title="Professional Highlights" subtitle="Verified metrics from an 18+ year engineering career." />
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2rem; margin-bottom: 4rem;">
    {profile.metrics.map((m) => (
      <div style="padding: 2rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface);">
        <p style="font-family: var(--font-serif); font-size: 2rem; font-weight: 500; margin: 0 0 0.5rem 0; color: var(--color-accent);">{m.value}</p>
        <p style="font-size: 0.95rem; color: var(--color-text-secondary); margin: 0 0 0.75rem 0;">{m.label}</p>
        <p style="font-size: 0.8rem; color: var(--color-text-secondary); margin: 0;">{m.basis}</p>
      </div>
    ))}
  </div>

  <!-- Section 3: About Me Preview -->
  <SectionHeading title="About Me" subtitle="A snapshot of my professional journey and engineering philosophy." />
  <div style="max-width: 760px; margin: 0 auto 4rem auto;">
    <p style="font-size: 1.05rem; color: var(--color-text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">{profile.longIntro[0]}</p>
    <p style="font-size: 1.05rem; color: var(--color-text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">{profile.longIntro[2]}</p>
    <a href="/about" class="link-accent">Read my full story →</a>
  </div>

  <!-- Section 4: Featured Achievements -->
  <SectionHeading title="Featured Achievements" subtitle="Selected engineering and business outcomes." />
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 4rem;">
    {selectedAchievements.map((entry) => {
      const a = entry.data;
      return (
        <article class="card" style="border-left: 3px solid var(--color-accent);">
          <h3 style="font-size: 1.125rem; margin: 0 0 0.5rem 0; letter-spacing: -0.01em;">{a.title}</h3>
          <p style="font-size: 0.875rem; color: var(--color-text-secondary); margin: 0.25rem 0 0.75rem 0;">{a.organization} · {a.year}</p>
          <p style="font-size: 0.9rem; color: var(--color-text-secondary); margin: 0 0 0.75rem 0;">{a.description}</p>
          {a.impact && <p style="font-size: 0.9rem; color: var(--color-accent); font-weight: 600; margin: 0 0 0.5rem 0;">{a.impact}</p>}
          <a href="/achievements" class="link-accent" style="font-size: 0.85rem;">View all achievements →</a>
        </article>
      );
    })}
  </div>

  <!-- Section 5: Awards & Recognition Preview -->
  <SectionHeading title="Awards & Recognition" subtitle="External recognition of engineering excellence." />
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 4rem;">
    {featuredAwards.length > 0 ? (
      featuredAwards.map((entry) => <AwardCard award={entry.data} variant="preview" />)
    ) : (
      <div style="grid-column: 1 / -1; text-align: center; padding: 3rem; color: var(--color-text-secondary);">
        <p>Awards will appear here once certificates are uploaded via the admin interface.</p>
      </div>
    )}
  </div>
  <CertificateLightbox />

  <!-- Section 6: Featured Personal Research -->
  <SectionHeading title="Personal Research" subtitle="Independent experiments in AI and software engineering." />
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 4rem;">
    {featuredResearch.length > 0 ? (
      featuredResearch.map((entry) => {
        const project = entry.data;
        return (
          <article class="card" style="border-left: 3px solid var(--color-accent-secondary);">
            <div style="aspect-ratio: 16/9; overflow: hidden; border-radius: var(--radius-sm); border: 1px solid var(--color-border); margin-bottom: 1rem; background: var(--color-muted-bg); position: relative;">
              {project.coverImage && (
                <img src={project.coverImage} alt={`Research: ${project.name}`} style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
              )}
              {!project.coverImage && (
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--color-text-secondary); font-size: 0.875rem;">Diagram not yet uploaded</div>
              )}
              <span style="position: absolute; top: 0.75rem; left: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); padding: 0.25rem 0.75rem; border-radius: var(--radius-sm); font-size: 0.7rem; font-weight: 600; text-transform: uppercase;">{project.status}</span>
            </div>
            <h3 style="font-size: 1.125rem; margin: 0 0 0.5rem 0; letter-spacing: -0.01em;">{project.name}</h3>
            <p style="font-size: 0.875rem; color: var(--color-text-secondary); margin: 0 0 0.5rem 0;">{project.category}</p>
            <p style="font-size: 0.9rem; color: var(--color-text-secondary); margin: 0 0 0.75rem 0;">{project.description}</p>
            <div style="margin-top: auto; display: flex; gap: 0.5rem; flex-wrap: wrap;">
              {project.techStack.map((t) => (
                <span style="font-size: 0.75rem; color: var(--color-text-secondary); border: 1px solid var(--color-border); padding: 0.2rem 0.5rem; border-radius: var(--radius-sm);">{t}</span>
              ))}
              <a href={`/research/${entry.id}`} style="margin-left: auto; font-size: 0.85rem; color: var(--color-accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px;">Case study →</a>
            </div>
          </article>
        );
      })
    ) : (
      <div style="grid-column: 1 / -1; text-align: center; padding: 3rem; color: var(--color-text-secondary);">
        <p>Research projects will appear here once added via the admin interface.</p>
      </div>
    )}
  </div>

  <!-- Section 7: Latest Technical Articles -->
  <SectionHeading title="Latest Technical Articles" subtitle="Writing on architecture, AI, and engineering leadership." />
  {latestPosts.length > 0 ? (
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-bottom: 4rem;">
      {posts.map((p) => {
        const slug = p.id.replace(/\.(md|mdx)$/, '');
        return (
          <article class="card">
            <div style="aspect-ratio: 16/9; overflow: hidden; border-radius: var(--radius-sm); border: 1px solid var(--color-border); margin-bottom: 1rem; background: var(--color-muted-bg);">
              {p.data.coverImage && (
                <img src={p.data.coverImage} alt={`Cover: ${p.data.title}`} style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
              )}
            </div>
            <div style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem;">
              <span class="badge badge-category">{p.data.category}</span>
              <span style="font-size: 0.75rem; color: var(--color-text-secondary);">{p.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            </div>
            <h3 style="font-size: 1.125rem; margin: 0 0 0.5rem 0; letter-spacing: -0.01em;">
              <a href={`/blog/${slug}`} style="color: var(--color-text); text-decoration: none;">{p.data.title}</a>
            </h3>
            <p style="color: var(--color-text-secondary); font-size: 0.95rem; margin: 0;">{p.data.description}</p>
          </article>
        );
      })}
    </div>
  ) : (
    <p style="text-align: center; color: var(--color-text-secondary);">No published articles yet.</p>
  )}
  <div style="text-align: center;">
    <a href="/blog" class="link-accent">View all articles →</a>
  </div>

  <!-- Section 8: Contact -->
  <section aria-label="Contact" style="padding: 4rem 0; max-width: 760px; margin: 0 auto; text-align: center; border-top: 1px solid var(--color-border);">
    <p class="eyebrow" style="margin-bottom: 1rem;">Contact</p>
    <h2 style="font-size: 2rem; margin: 0 0 1rem 0;">Let's Connect and Exchange Ideas.</h2>
    <p style="color: var(--color-text-secondary); margin-bottom: 2rem;">Best for VP / Director / Head of Engineering, Enterprise Architecture, and AI Engineering leadership conversations.</p>
    <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
      <a href={`mailto:${profile.email}`} class="btn btn-secondary" style="padding: 0.875rem 1.75rem;">{profile.email}</a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary" style="padding: 0.875rem 1.75rem;">LinkedIn ↗</a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary" style="padding: 0.875rem 1.75rem;">GitHub ↗</a>
      <a href={profile.resumePdfPath} download class="btn btn-primary" style="padding: 0.875rem 1.75rem;">Resume</a>
    </div>
  </section>
</BaseLayout>
