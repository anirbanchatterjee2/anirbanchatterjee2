---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import { employers, seoDefaults } from '../data/experience';
import { profile } from '../data/profile';
import { breadcrumbJsonLd } from '../lib/seo';
---
<BaseLayout title="Experience — Anirban Chatterjee" description="Detailed chronological experience — VP Engineering at Citi, Qualcomm and TCS architecture, 18+ years." path="/experience" jsonLd={[breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Experience', path: '/experience' }])]}>
  <div style="max-width: 832px; margin: 0 auto;">
    <SectionHeading title="Experience" subtitle="Strict reverse-chronological order, nested under employer." />
    <p style="font-size: 14px; color: var(--color-text-secondary); margin-bottom: 2rem;">Open to: {profile.targetRoles.join(' · ')}.</p>
    {employers.map((employer) => (
      <section style="margin-bottom: 3rem;">
        <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem;">{employer.company}</h2>
        <p style="font-size: 0.9rem; color: var(--color-text-secondary); margin-bottom: 1rem;">{employer.roles.map((r) => `${r.designation} · ${r.duration} · ${r.location}`).join(' · ')}</p>
        {employer.gapAfter && (
          <p style="font-size: 0.8rem; color: var(--color-text-secondary); font-style: italic; margin-bottom: 1rem;">{employer.gapAfter}</p>
        )}
        {employer.roles.map((role) => (
          <ExperienceItem key={role.designation + role.duration} role={role} employer={employer.company} />
        ))}
      </section>
    ))}
    <div style="margin-top: 3rem; border-top: 1px solid var(--color-border); padding-top: 2rem;">
      <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Education & Certification</h3>
      <p style="font-size: 0.95rem; color: var(--color-text-secondary); margin: 0.5rem 0;"><strong>Bachelor of Technology — Computer Science & Engineering</strong>, West Bengal University of Technology — Kolkata, India</p>
      <p style="font-size: 0.95rem; color: var(--color-text-secondary); margin: 0;"><strong>Sun Certified Java Programmer 5</strong>, Sun Microsystems</p>
    </div>
  </div>
</BaseLayout>
