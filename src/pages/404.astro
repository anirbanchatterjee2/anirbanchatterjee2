---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" description="The page you requested could not be found." path="/404">
  <div style="max-width: 560px; margin: 0 auto; text-align: center; padding: 48px 0;">
    <h1 style="font-size: 48px; margin-bottom: 8px;">404</h1>
    <p style="color: var(--color-text-secondary); margin-bottom: 24px;">That page doesn’t exist. Try the homepage or the blog.</p>
    <div style="display: flex; gap: 12px; justify-content: center;">
      <a href="/" style="background: var(--color-accent); color: #fff; padding: 10px 18px; border-radius: 6px; font-weight: 600; text-decoration: none;">Home</a>
      <a href="/blog" style="border: 1px solid var(--color-border); padding: 10px 18px; border-radius: 6px; font-weight: 600; color: var(--color-text); text-decoration: none;">Blog</a>
    </div>
  </div>
</BaseLayout>
