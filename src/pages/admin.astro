---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbJsonLd } from '../lib/seo';
export const prerender = true;
---
<BaseLayout title="Admin — Coming Soon" description="Private workspace for content management." path="/admin" noindex jsonLd={[breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Admin', path: '/admin' }])]}>
  <div style="max-width: 560px; margin: 0 auto;">
    <h1 style="font-size: 2rem; margin-bottom: 1rem;">Content Management</h1>
    <p>Access the Decap CMS admin interface at <a href="/admin/">/admin/</a> (authentication required).</p>
    <p>Content is managed via GitHub in the <code>src/content/</code> folders.</p>
    <p><a href="/">← Back to public site</a></p>
  </div>
</BaseLayout>
