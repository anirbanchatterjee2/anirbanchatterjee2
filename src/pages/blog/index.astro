---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedPosts, getAllTags, getAllCategories } from '../../lib/blog';
import { humanize } from '../../lib/utils';

const posts = await getPublishedPosts();
const tags = await getAllTags();
const categories = await getAllCategories();
const active = 'all';
---
<BaseLayout title="Blog" description="Technical articles on software engineering, architecture, AI, RAG and agentic systems — the canonical publication." path="/blog">
  <div style="max-width: 832px; margin: 0 auto;">
    <h1 style="font-size: 32px; margin-bottom: 8px;">Technical blog</h1>
    <p style="color: var(--color-text-secondary); margin-bottom: 24px;">Every article has a permanent URL and a LinkedIn-ready preview. Search and filter by category or tag below.</p>

    <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px;">
      <button type="button" data-filter="all" aria-pressed="true" style="border: 1px solid var(--color-accent); background: var(--color-accent); color: #fff; padding: 6px 12px; border-radius: 999px; font-size: 13px;">All</button>
      {categories.map((c) => (
        <button type="button" data-filter={c.category} style="border: 1px solid var(--color-border); background: transparent; color: var(--color-text); padding: 6px 12px; border-radius: 999px; font-size: 13px;">{humanize(c.category)} ({c.count})</button>
      ))}
    </div>
    <input id="blog-search" type="search" placeholder="Search title, description or tag…" aria-label="Search articles" style="width: 100%; padding: 10px 12px; border: 1px solid var(--color-border); border-radius: 6px; margin-bottom: 24px; background: var(--color-surface); color: var(--color-text); font-size: 15px;" />
    <p style="font-size: 14px; color: var(--color-text-secondary); margin-bottom: 8px;">
      Tags: {tags.map((t) => <a href={`/blog/tags/${t.tag}`} style="color: var(--color-accent); text-decoration: none; margin-right: 8px;">#{humanize(t.tag)}</a>)}
    </p>

    <div id="blog-list" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; margin-top: 16px;">
      {posts.map((p) => (
        <div data-category={p.data.category.toLowerCase().replace(/\s+/g, '-')} data-search={`${p.data.title} ${p.data.description} ${p.data.tags.join(' ')}`.toLowerCase()}>
          <ArticleCard post={p} />
        </div>
      ))}
    </div>
    <p id="blog-empty" hidden style="color: var(--color-text-secondary);">No articles match your search.</p>
  </div>
  <script>
    const input = document.getElementById('blog-search');
    const items = [...document.querySelectorAll('[data-search]')];
    const empty = document.getElementById('blog-empty');
    let activeFilter = 'all';
    function apply() {
      const q = (input?.value ?? '').toLowerCase();
      let visible = 0;
      for (const el of items) {
        const cat = el.getAttribute('data-category');
        const hay = el.getAttribute('data-search') ?? '';
        const matchCat = activeFilter === 'all' || cat === activeFilter;
        const matchQ = !q || hay.includes(q);
        const show = matchCat && matchQ;
        el.hidden = !show;
        if (show) visible++;
      }
      if (empty) empty.hidden = visible !== 0;
    }
    input?.addEventListener('input', apply);
    document.querySelectorAll('[data-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        activeFilter = btn.getAttribute('data-filter') ?? 'all';
        document.querySelectorAll('[data-filter]').forEach((b) => {
          const isActive = b.getAttribute('data-filter') === activeFilter;
          b.setAttribute('aria-pressed', String(isActive));
          b.style.border = isActive ? '1px solid var(--color-accent)' : '1px solid var(--color-border)';
          b.style.background = isActive ? 'var(--color-accent)' : 'transparent';
          b.style.color = isActive ? '#fff' : 'var(--color-text)';
        });
        apply();
      });
    });
  </script>
</BaseLayout>
