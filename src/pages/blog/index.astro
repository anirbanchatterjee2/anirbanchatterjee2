---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedPosts, getAllTags, getAllCategories } from '../../lib/blog';
import { humanize } from '../../lib/utils';
import { seoDefaults } from '../../data/profile';
import { breadcrumbJsonLd } from '../../lib/seo';

const posts = await getPublishedPosts();
const tags = await getAllTags();
const categories = await getAllCategories();
---
<BaseLayout title="Technical Blogs — Anirban Chatterjee" description="Technical articles on software engineering, architecture, AI, RAG and agentic systems." path="/blog" jsonLd={[breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Technical Blogs', path: '/blog' }])]}>
  <div style="max-width: 1152px; margin: 0 auto;">
    <SectionHeading title="Technical Blogs" subtitle="Writing on software engineering, architecture, AI, RAG and agentic systems." />
    
    <!-- Filters -->
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 2rem;">
      <button onclick="filterBlog('all')" id="filter-blog-all" class="badge badge-category" style="cursor: pointer; border-color: var(--color-accent); color: var(--color-accent);">All</button>
      {categories.map((c) => (
        <button onclick="filterBlog('{c.category}')" id={`filter-blog-${c.category.toLowerCase().replace(/\s/g, '-')}`} class="badge badge-category" style="cursor: pointer;">{humanize(c.category)}</button>
      ))}
    </div>
    <input id="blog-search" type="search" placeholder="Search articles…" aria-label="Search articles" style="width: 100%; max-width: 400px; padding: 0.75rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface); color: var(--color-text); font-size: 0.9rem; margin-bottom: 2rem;" />

    <div id="blog-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
      {posts.map((p) => {
        const slug = p.id.replace(/\.(md|mdx)$/, '');
        return (
          <article class="card" data-category={p.data.category} data-search={`${p.data.title} ${p.data.description} ${p.data.tags.join(' ')}`.toLowerCase()}>
            <div style="aspect-ratio: 16/9; overflow: hidden; border-radius: var(--radius-sm); border: 1px solid var(--color-border); margin-bottom: 1rem; background: var(--color-muted-bg);">
              {p.data.coverImage && (
                <img src={p.data.coverImage} alt={`Cover: ${p.data.title}`} style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
              )}
            </div>
            <div style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem;">
              <span class="badge badge-category">{p.data.category}</span>
              <span style="font-size: 0.75rem; color: var(--color-text-secondary);">{p.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            </div>
            <h3 style="font-size: 1.125rem; margin: 0 0 0.5rem 0; letter-spacing: -0.01em;">
              <a href={`/blog/${slug}`} style="color: var(--color-text); text-decoration: none;">{p.data.title}</a>
            </h3>
            <p style="color: var(--color-text-secondary); font-size: 0.95rem; margin: 0;">{p.data.description}</p>
          </article>
        );
      })}
    </div>
    {posts.length === 0 && (
      <p style="text-align: center; color: var(--color-text-secondary); padding: 3rem;">No published articles yet.</p>
    )}
  </div>
  <script>
    function filterBlog(category) {
      const cards = document.querySelectorAll('#blog-grid > article');
      const buttons = document.querySelectorAll('.badge-category');
      buttons.forEach(b => {
        b.style.borderColor = 'var(--color-border)';
        b.style.color = 'var(--color-text-secondary)';
      });
      document.getElementById(`filter-blog-${category.toLowerCase().replace(/\s/g, '-')}`).style.borderColor = 'var(--color-accent)';
      document.getElementById(`filter-blog-${category.toLowerCase().replace(/\s/g, '-')}`).style.color = 'var(--color-accent)';
      const q = document.getElementById('blog-search').value.toLowerCase();
      cards.forEach(card => {
        const catMatch = category === 'all' || card.getAttribute('data-category') === category;
        const searchMatch = !q || card.getAttribute('data-search').includes(q);
        card.style.display = (catMatch && searchMatch) ? 'flex' : 'none';
      });
    }
    document.getElementById('blog-search').addEventListener('input', () => filterBlog('all'));
  </script>
</BaseLayout>
