---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { researchCategories, researchStatuses } from '../data/research';
import { seoDefaults } from '../data/profile';
import { breadcrumbJsonLd } from '../lib/seo';
import { getCollection } from 'astro:content';
---
<BaseLayout title="Projects & Research — Anirban Chatterjee" description="Personal engineering research projects and experiments in AI, distributed systems, and software architecture." path="/research" jsonLd={[breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Projects & Research', path: '/research' }])]}>
  <div style="max-width: 1152px; margin: 0 auto;">
    <SectionHeading title="Projects & Research" subtitle="Independent technical exploration — distinct from employer-owned work." />
    
    <!-- Filters -->
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 2rem;">
      <button onclick="filterResearch('all', 'all')" id="filter-cat-all" class="badge badge-category" style="cursor: pointer; border-color: var(--color-accent); color: var(--color-accent);">All Categories</button>
      {researchCategories.map((cat) => (
        <button onclick={`filterResearch('${cat}', 'all')}`} id={`filter-cat-${cat.toLowerCase()}`} class="badge badge-category" style="cursor: pointer;">{cat}</button>
      ))}
      <span style="font-size: 0.875rem; color: var(--color-text-secondary); margin: 0 0.5rem;">|</span>
      {researchStatuses.map((status) => (
        <button onclick={`filterResearch('all', '${status}')}`} id={`filter-status-${status.toLowerCase()}`} class="badge badge-status" style="cursor: pointer; border: 1px solid var(--color-border);">{status}</button>
      ))}
    </div>

    <div id="research-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem;">
      {(async () => {
        const entries = await getCollection('research', ({ data }) => data.draft !== true);
        return entries.map((entry) => {
          const project = entry.data;
          return (
            <article class="card" data-category={project.category} data-status={project.status}>
              <div style="aspect-ratio: 16/9; overflow: hidden; border-radius: var(--radius-sm); border: 1px solid var(--color-border); margin-bottom: 1rem; background: var(--color-muted-bg); position: relative;">
                {project.coverImage && (
                  <img src={project.coverImage} alt={`Research: ${project.name}`} style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
                )}
                {!project.coverImage && (
                  <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--color-text-secondary); font-size: 0.875rem;">Diagram not uploaded</div>
                )}
                <span style="position: absolute; top: 0.75rem; left: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); padding: 0.25rem 0.75rem; border-radius: var(--radius-sm); font-size: 0.7rem; font-weight: 600; text-transform: uppercase;">{project.status}</span>
              </div>
              <h3 style="font-size: 1.125rem; margin: 0 0 0.5rem 0; letter-spacing: -0.01em;">
                <a href={`/research/${entry.id}`} style="color: var(--color-text); text-decoration: none;">{project.name}</a>
              </h3>
              <p style="font-size: 0.875rem; color: var(--color-text-secondary); margin: 0 0 0.5rem 0;">{project.category}</p>
              <p style="font-size: 0.9rem; color: var(--color-text-secondary); margin: 0 0 0.75rem 0;">{project.description}</p>
              <div style="margin-top: auto; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                {project.techStack.map((t) => (
                  <span style="font-size: 0.75rem; color: var(--color-text-secondary); border: 1px solid var(--color-border); padding: 0.2rem 0.5rem; border-radius: var(--radius-sm);">{t}</span>
                ))}
                <a href={`/research/${entry.id}`} style="margin-left: auto; font-size: 0.85rem; color: var(--color-accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px;">Case study →</a>
              </div>
            </article>
          );
        });
      })()}
    </div>
    <p id="research-empty" style="text-align: center; color: var(--color-text-secondary); padding: 3rem;">No research projects published yet.</p>
  </div>
  <script>
    function filterResearch(category, status) {
      const cards = document.querySelectorAll('#research-grid > article');
      cards.forEach(card => {
        const catMatch = category === 'all' || card.getAttribute('data-category') === category;
        const statusMatch = status === 'all' || card.getAttribute('data-status') === status;
        card.style.display = (catMatch && statusMatch) ? 'flex' : 'none';
      });
    }
  </script>
</BaseLayout>
