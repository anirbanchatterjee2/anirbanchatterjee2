---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { achievementGroups } from '../data/achievements';
import { seoDefaults } from '../data/profile';
import { breadcrumbJsonLd } from '../lib/seo';
import { getCollection } from 'astro:content';
---
<BaseLayout title="Achievements — Anirban Chatterjee" description="Achievement library grouped by business impact, architecture, transformation, leadership, and recognition." path="/achievements" jsonLd={[breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Achievements', path: '/achievements' }])]}>
  <div style="max-width: 832px; margin: 0 auto;">
    <SectionHeading title="Achievement Library" subtitle="Engineering and business accomplishments — context, contribution, and verified outcomes." />
    {(async () => {
      const entries = await getCollection('achievements', ({ data }) => data.draft !== true);
      const grouped = achievementGroups
        .map((g) => ({ group: g, items: entries.filter((e) => e.data.group === g) }))
        .filter((g) => g.items.length > 0);
      return grouped.map((g) => (
        <section aria-label={g.group} style="margin-bottom: 3rem;">
          <h2 style="font-size: 1.5rem; border-bottom: 2px solid var(--color-text); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">{g.group}</h2>
          {g.items.map((entry) => {
            const a = entry.data;
            return (
              <article class="card" style="border-left: 3px solid var(--color-accent); margin-bottom: 1.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.75rem;">
                  <h3 style="font-size: 1.125rem; margin: 0; letter-spacing: -0.01em;">{a.title}</h3>
                  {a.impact && <span style="font-size: 0.875rem; font-weight: 700; color: var(--color-accent); white-space: nowrap;">{a.impact}</span>}
                </div>
                <p style="font-size: 0.875rem; color: var(--color-text-secondary); margin: 0.25rem 0 0.75rem 0;">{a.organization} · {a.year}</p>
                <p style="font-size: 0.9rem; color: var(--color-text-secondary); margin: 0 0 1rem 0;">{a.description}</p>
                <p style="font-size: 0.9rem; color: var(--color-text-secondary); margin: 0;"><strong style="color: var(--color-text);">Contribution:</strong> {a.contribution}</p>
                {a.measurementBasis && (
                  <p style="font-size: 0.8rem; color: var(--color-text-secondary); margin-top: 0.5rem;">Basis: {a.measurementBasis}</p>
                )}
                <div style="margin-top: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                  {a.tags.map((tag) => (
                    <span style="font-size: 0.75rem; color: var(--color-accent); border: 1px solid rgba(22, 58, 95, 0.2); padding: 0.2rem 0.5rem; border-radius: var(--radius-sm);">{tag}</span>
                  ))}
                </div>
              </article>
            );
          })}
        </section>
      ));
    })()}
  </div>
</BaseLayout>
