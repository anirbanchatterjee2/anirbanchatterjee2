---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---
<BaseLayout title="About" description={`Professional background of ${profile.name} — 18+ years in software engineering, AML/risk platforms, and engineering leadership.`} path="/about">
  <article style="max-width: 720px; margin: 0 auto;">
    <h1 style="font-size: 32px; margin-bottom: 16px;">About me</h1>
    <p style="font-size: 18px; color: var(--color-text-secondary); margin-bottom: 24px;">{profile.shortIntro}</p>
    {profile.longIntro.map((p) => <p style="margin-bottom: 20px;">{p}</p>)}
    <h2 style="font-size: 22px; margin: 32px 0 16px;">Current areas of interest</h2>
    <ul style="list-style: disc; padding-left: 24px; color: var(--color-text-secondary);">
      {profile.currentInterests.map((i) => <li style="margin-bottom: 6px;"><strong style="color: var(--color-text);">{i.title}</strong> — {i.note}</li>)}
    </ul>
    <h2 style="font-size: 22px; margin: 32px 0 16px;">Engineering leadership philosophy</h2>
    <p style="margin-bottom: 16px;">Great engineering organisations are built through disciplined operating models, not just talent. My consistent focus is on building the machine that builds the product.</p>
    {profile.leadershipPrinciples.map((p) => (
      <div style="border-left: 3px solid var(--color-accent); padding-left: 16px; margin-bottom: 16px;">
        <h3 style="font-size: 16px;">{p.title}</h3>
        <p style="color: var(--color-text-secondary);">{p.note}</p>
      </div>
    ))}
    <h2 style="font-size: 22px; margin: 32px 0 16px;">Connect</h2>
    <p style="display: flex; gap: 16px; flex-wrap: wrap;">
      {profile.socials.map((s) => <a href={s.href} target={s.href.startsWith('mailto:') ? undefined : '_blank'} rel={s.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'} style="color: var(--color-accent);">{s.label} ↗</a>)}
    </p>
  </article>
</BaseLayout>
