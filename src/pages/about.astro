---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { profile, seoDefaults } from '../data/profile';
import { profilePhoto } from '../data/profilePhoto';
import { breadcrumbJsonLd } from '../lib/seo';
---
<BaseLayout title="About — Anirban Chatterjee" description="Professional biography of Anirban Chatterjee — 18+ years from Java engineering in 2008 to VP Engineering in regulated financial services." path="/about" jsonLd={[breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }])]}>
  <div style="max-width: 760px; margin: 0 auto;">
    <SectionHeading title="About Me" subtitle="My journey from hands-on engineering to engineering leadership." />
    <div style="display: grid; grid-template-columns: 1fr 300px; gap: 4rem; align-items: start;">
      <div>
        <p style="font-size: 1.1rem; color: var(--color-text-secondary); line-height: 1.75; margin-bottom: 2rem;">{profile.shortIntro}</p>
        {profile.longIntro.map((p, i) => (
          <p style="font-size: 1.1rem; color: var(--color-text-secondary); line-height: 1.75; margin-bottom: 2rem;" key={i}>{p}</p>
        ))}
        <div style="margin-top: 3rem;">
          <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">Engineering Philosophy</h3>
          {profile.leadershipPrinciples.map((p) => (
            <div style="border-left: 3px solid var(--color-accent); padding-left: 1.5rem; margin-bottom: 1.5rem;">
              <h4 style="font-size: 1rem; margin: 0 0 0.5rem 0; color: var(--color-text);">{p.title}</h4>
              <p style="color: var(--color-text-secondary); margin: 0; font-size: 0.95rem;">{p.note}</p>
            </div>
          ))}
        </div>
      </div>
      <aside style="border: 1px solid var(--color-border); border-radius: var(--radius); padding: 2rem; background: var(--color-surface); position: sticky; top: 8rem;">
        <div style="aspect-ratio: 1; border: 1px solid var(--color-border); border-radius: var(--radius); overflow: hidden; margin-bottom: 1.5rem;">
          {profilePhoto.src && !profilePhoto.src.includes('placeholder') ? (
            <img src={profilePhoto.src} alt={profilePhoto.alt} style="width: 100%; height: 100%; object-fit: cover;" />
          ) : (
            <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: var(--color-muted-bg); color: var(--color-text-secondary); font-size: 0.875rem;">Photograph not uploaded</div>
          )}
        </div>
        <h4 style="font-size: 1rem; margin: 0 0 0.5rem 0; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-secondary);">Current Focus</h4>
        <ul style="list-style: none; padding: 0; margin: 0 0 2rem 0; color: var(--color-text-secondary); font-size: 0.9rem;">
          {profile.currentInterests.map((i) => (
            <li style="margin-bottom: 0.75rem;"><strong style="color: var(--color-text);">{i.title}</strong> — {i.note}</li>
          ))}
        </ul>
        <h4 style="font-size: 1rem; margin: 0 0 0.5rem 0; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-secondary);">Open To</h4>
        <p style="font-size: 0.875rem; color: var(--color-text-secondary); margin: 0 0 1rem 0;">{profile.openTo.roles}</p>
        <p style="font-size: 0.875rem; color: var(--color-text-secondary); margin: 0;">{profile.openTo.locationMobility}</p>
      </aside>
    </div>
    <div style="margin-top: 4rem; border-top: 1px solid var(--color-border); padding-top: 2rem;">
      <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">Beyond Engineering</h3>
      <p style="color: var(--color-text-secondary); line-height: 1.7;">Outside of technology, I'm interested in science, history, geography, economics, global affairs, travel, and exploring new ideas. I believe these interests inform how I approach engineering problems — with curiosity, context, and a willingness to look beyond the obvious solution.</p>
    </div>
  </div>
</BaseLayout>
