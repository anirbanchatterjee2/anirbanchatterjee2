---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, seoDefaults } from '../data/profile';
import { employers, education, certifications } from '../data/experience';
import { capabilityThemes } from '../data/skills';
import { breadcrumbJsonLd } from '../lib/seo';
---
<BaseLayout title="Resume — Anirban Chatterjee" description={`Resume of ${profile.name} — ${profile.headline}. Print-friendly and downloadable as PDF.`} path="/resume" jsonLd={[breadcrumbJsonLd([{ name: 'Home', path: '/' }, { name: 'Resume', path: '/resume' }])]}>
  <!-- Screen-only actions -->
  <div class="no-print" style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem;">
    <button type="button" onclick="window.print()" class="btn btn-primary">Print / Save as PDF</button>
    <a id="resume-download" href={profile.resumePdfPath} download class="btn btn-secondary">Download PDF ↓</a>
    <a href={`mailto:${profile.email}`} class="btn btn-secondary">{profile.email}</a>
  </div>
  <p id="resume-fallback" class="no-print" role="status" style="display: none; border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1rem 1.25rem; margin-bottom: 2rem; background: var(--color-surface);">
    The PDF file is not deployed yet. Use <strong>Print / Save as PDF</strong> above to generate it directly from this page — content is identical.
  </p>
  <script>
    (function () {
      const link = document.getElementById('resume-download');
      const note = document.getElementById('resume-fallback');
      if (!link || !note) return;
      fetch(link.getAttribute('href') ?? '', { method: 'HEAD' }).then(async (res) => {
        if (!res.ok) {
          link.remove();
          note.style.display = 'block';
        }
      }).catch(() => {
        link.remove();
        note.style.display = 'block';
      });
    })();
  </script>

  <!-- Print-friendly resume -->
  <article style="max-width: 832px; margin: 0 auto;">
    <h1 style="font-size: 2rem; margin-bottom: 0.25rem;">Anirban Chatterjee</h1>
    <p style="font-weight: 600; color: var(--color-accent); margin-bottom: 0.5rem;">{profile.headline}</p>
    <p style="font-size: 0.9rem; color: var(--color-text-secondary); margin-bottom: 1rem;">{profile.email} · {profile.linkedin} · {profile.github}</p>
    <p style="margin-bottom: 2rem;">{profile.shortIntro} Open to: {profile.targetRoles.join(' · ')}.</p>

    <h2 style="font-size: 1.25rem; border-bottom: 1px solid var(--color-border); padding-bottom: 0.5rem;">Experience</h2>
    {employers.map((emp) => (
      <section style="margin-bottom: 1.5rem;">
        <h3 style="font-size: 1rem; margin-bottom: 0.5rem;">{emp.company}</h3>
        {emp.roles.map((e) => (
          <section style="margin-bottom: 1rem;">
            <div style="display: flex; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap;">
              <strong style="font-size: 1rem;">{e.designation}</strong>
              <span style="font-size: 0.875rem; color: var(--color-text-secondary);">{e.duration}</span>
            </div>
            <p style="font-size: 0.875rem; color: var(--color-text-secondary); margin: 0.25rem 0 0.5rem 0;">{e.location}</p>
            <p style="font-size: 0.9rem; margin-bottom: 0.5rem;">{e.summary}</p>
            <ul style="list-style: disc; padding-left: 1.25rem; font-size: 0.9rem; margin-bottom: 0.5rem;">
              {[...e.responsibilities, ...e.achievements].map((r) => <li>{r}</li>)}
            </ul>
            <p style="font-size: 0.8rem; color: var(--color-text-secondary);">{e.technologies.join(' · ')}</p>
          </section>
        ))}
      </section>
    ))}

    <h2 style="font-size: 1.25rem; border-bottom: 1px solid var(--color-border); padding-bottom: 0.5rem;">Skills</h2>
    {capabilityThemes.map((theme) => (
      <p style="font-size: 0.9rem; margin-bottom: 0.5rem;"><strong>{theme.title}:</strong> {theme.items.join(' · ')}</p>
    ))}

    <h2 style="font-size: 1.25rem; border-bottom: 1px solid var(--color-border); padding-bottom: 0.5rem;">Education & Certification</h2>
    {education.map((ed) => <p style="font-size: 0.9rem; margin-bottom: 0.5rem;"><strong>{ed.degree}</strong>, {ed.institution} — {ed.year}</p>)}
    {certifications.map((c) => <p style="font-size: 0.9rem; margin-bottom: 0.5rem;"><strong>{c.name}</strong>, {c.issuer} — {c.year}</p>)}
  </article>
</BaseLayout>
