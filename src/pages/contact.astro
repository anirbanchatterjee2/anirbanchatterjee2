---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---
<BaseLayout title="Contact" description={`Contact ${profile.name} — email, LinkedIn and GitHub only. No unnecessary personal information.`} path="/contact">
  <div style="max-width: 560px; margin: 0 auto;">
    <p class="eyebrow">Contact</p>
    <h1 style="font-size: 34px; margin-bottom: 8px;">Get in touch</h1>
    <p style="color: var(--color-text-secondary); margin-bottom: 32px;">Best for VP / Director / Head of Engineering, Enterprise Architecture, and AI Engineering leadership conversations.</p>
    <div style="display: grid; gap: 16px;">
      <a href={`mailto:${profile.email}`} style="border: 1px solid var(--color-border); border-radius: var(--radius); padding: 20px; background: var(--color-surface); text-decoration: none; color: var(--color-text); display: block;">
        <strong>Email</strong><br /><span style="color: var(--color-accent);">{profile.email}</span>
      </a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" style="border: 1px solid var(--color-border); border-radius: var(--radius); padding: 20px; background: var(--color-surface); text-decoration: none; color: var(--color-text); display: block;">
        <strong>LinkedIn</strong><br /><span style="color: var(--color-text-secondary);">{profile.linkedin}</span>
      </a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer" style="border: 1px solid var(--color-border); border-radius: var(--radius); padding: 20px; background: var(--color-surface); text-decoration: none; color: var(--color-text); display: block;">
        <strong>GitHub</strong><br /><span style="color: var(--color-text-secondary);">{profile.github}</span>
      </a>
    </div>

    <h2 style="font-size: 22px; margin: 40px 0 16px;">Or send a message</h2>
    <p style="color: var(--color-text-secondary); font-size: 14px; margin-bottom: 20px;">Netlify Forms handles delivery — no backend required. Spam protection via honeypot field.</p>
    <form netlify name="contact" method="POST" style="display: grid; gap: 16px;">
      <input type="hidden" name="form-name" value="contact" />
      <!-- Honeypot field — bots fill it, humans don't -->
      <label style="position: absolute; left: -9999px; aria-hidden: true;">If you're a human, leave this blank: <input name="hp" /></label>
      <div>
        <label style="display: block; font-size: 14px; color: var(--color-text-secondary); margin-bottom: 6px;">Name</label>
        <input type="text" name="name" required style="width: 100%; padding: 10px 12px; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface); color: var(--color-text); font-size: 15px;" />
      </div>
      <div>
        <label style="display: block; font-size: 14px; color: var(--color-text-secondary); margin-bottom: 6px;">Email</label>
        <input type="email" name="email" required style="width: 100%; padding: 10px 12px; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface); color: var(--color-text); font-size: 15px;" />
      </div>
      <div>
        <label style="display: block; font-size: 14px; color: var(--color-text-secondary); margin-bottom: 6px;">Message</label>
        <textarea name="message" rows="5" required style="width: 100%; padding: 10px 12px; border: 1px solid var(--color-border); border-radius: var(--radius); background: var(--color-surface); color: var(--color-text); font-size: 15px;"></textarea>
      </div>
      <button type="submit" style="background: var(--color-accent); color: #fff; padding: 11px 20px; border-radius: 6px; font-weight: 600; border: none; cursor: pointer;">Send message</button>
    </form>
    <p id="contact-success" style="display: none; color: var(--color-accent); font-weight: 600; margin-top: 16px;">Thank you — your message has been sent.</p>
  </div>
  <script>
    (function () {
      const form = document.querySelector('form[name="contact"]');
      const success = document.getElementById('contact-success');
      if (!form || !success) return;
      form.addEventListener('submit', () => {
        setTimeout(() => { success.style.display = 'block'; }, 800);
      });
    })();
  </script>
</BaseLayout>
