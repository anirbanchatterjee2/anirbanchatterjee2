---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { getAllProjects } from '../../lib/blog';
import { seoDefaults } from '../../data/profile';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', ({ data }) => data.draft !== true);
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.(md|mdx)$/, '') },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const statusLabel = { 'concept': 'Concept', 'research': 'Research', 'in-development': 'In Development', 'prototype': 'Prototype', 'completed': 'Completed' }[project.data.status];
const path = `/projects/${project.id.replace(/\.(md|mdx)$/, '')}`;
---
<BaseLayout title={project.data.name} description={project.data.description} path={path} image={project.data.coverImage}>
  <article style="max-width: 720px; margin: 0 auto;">
    <p style="font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-secondary);">
      Status: {statusLabel}{project.data.startedYear && ` · Started ${project.data.startedYear}`}
    </p>
    <h1 style="font-size: 36px; margin: 8px 0 12px;">{project.data.name}</h1>
    <p style="font-size: 18px; color: var(--color-text-secondary); margin-bottom: 16px;">{project.data.description}</p>
    {project.data.techStack.length > 0 && (
      <p style="font-size: 14px; color: var(--color-text-secondary); margin-bottom: 24px;"><strong>Stack:</strong> {project.data.techStack.join(' · ')}</p>
    )}
    <p style="display: flex; gap: 16px; margin-bottom: 32px;">
      {project.data.repoUrl && <a href={project.data.repoUrl} target="_blank" rel="noopener noreferrer" style="font-weight: 600; color: var(--color-accent);">GitHub ↗</a>}
      {project.data.demoUrl && <a href={project.data.demoUrl} target="_blank" rel="noopener noreferrer" style="font-weight: 600; color: var(--color-accent);">Live demo ↗</a>}
    </p>
    {project.data.coverImage && <img src={project.data.coverImage} alt={`Diagram / screenshot for ${project.data.name}`} style="width: 100%; border-radius: var(--radius); border: 1px solid var(--color-border); margin-bottom: 32px;" />}
    <div class="prose"><Content /></div>
    <p style="margin-top: 32px;"><a href="/projects" style="color: var(--color-accent); font-weight: 600;">← All projects</a></p>
  </article>
</BaseLayout>
