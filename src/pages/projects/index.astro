---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getAllProjects } from '../../lib/blog';
const projects = await getAllProjects();
---
<BaseLayout title="Labs & Research" description="Technical projects and experiments — engineering diagram intelligence, agentic efficiency, and AI engineering research. Statuses labelled honestly: concept and active development." path="/projects">
  <div style="max-width: 832px; margin: 0 auto;">
    <p class="eyebrow">AI</p>
    <h1 style="font-size: 34px; margin-bottom: 8px;">Labs & research</h1>
    <p style="color: var(--color-text-secondary); margin-bottom: 24px;">Experimental and research projects in AI and software engineering. Each is labelled with its honest development status — concept, research, or in development.</p>
    {projects.map((p) => <ProjectCard project={p} />)}
    <p style="margin-top: 24px; color: var(--color-text-secondary); font-size: 14px;">Add a project by creating a new file in <code>src/content/projects/</code> — see docs/PUBLISHING.md.</p>
  </div>
</BaseLayout>
