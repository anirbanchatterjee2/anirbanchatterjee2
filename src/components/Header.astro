---
import { profile } from '../data/profile';
import { navLinks } from '../data/navigation';
import ThemeToggle from './ThemeToggle.astro';

const current = Astro.url.pathname;
---
<header class="no-print" style="position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--color-bg) 85%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--color-border);">
  <div style="max-width: 1152px; margin: 0 auto; padding: 0 24px; height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 16px;">
    <a href="/" aria-label={`${profile.name} — home`} style="font-weight: 700; font-size: 18px; letter-spacing: -0.02em; color: var(--color-text); text-decoration: none; white-space: nowrap;">
      {profile.name}
    </a>
    <nav aria-label="Primary" style="display: flex; align-items: center; gap: 4px; flex-wrap: wrap;">
      {navLinks.map((l) => (
        <a
          href={l.href}
          aria-current={current === l.href || (l.href !== '/' && current.startsWith(l.href)) ? 'page' : undefined}
          style={`padding: 6px 10px; border-radius: 6px; font-size: 14px; text-decoration: none; ${current === l.href ? 'color: var(--color-accent); font-weight: 600;' : 'color: var(--color-text-secondary);'}`}
        >
          {l.label}
        </a>
      ))}
      <ThemeToggle />
      <a
        href={profile.resumePdfPath}
        download
        style="margin-left: 8px; background: var(--color-accent); color: #fff; padding: 7px 14px; border-radius: 6px; font-size: 14px; font-weight: 600; text-decoration: none; white-space: nowrap;"
      >
        Resume ↓
      </a>
    </nav>
  </div>
</header>
