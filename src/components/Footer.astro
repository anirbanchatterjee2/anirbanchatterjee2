---
import { profile } from '../data/profile';
import { footerLinks } from '../data/navigation';
---
<footer class="no-print" style="border-top: 1px solid var(--color-border); margin-top: 80px;">
  <div style="max-width: 1152px; margin: 0 auto; padding: 40px 24px; display: flex; flex-wrap: wrap; gap: 32px; justify-content: space-between;">
    <div>
      <p style="font-weight: 700; margin-bottom: 4px;">{profile.name}</p>
      <p style="color: var(--color-text-secondary); font-size: 14px; max-width: 360px;">{profile.headline}</p>
    </div>
    <nav aria-label="Footer" style="display: flex; gap: 16px; flex-wrap: wrap;">
      {footerLinks.main.map((l) => (
        <a href={l.href} style="color: var(--color-text-secondary); font-size: 14px; text-decoration: none;">{l.label}</a>
      ))}
    </nav>
    <div style="display: flex; gap: 16px;">
      {footerLinks.socials.map((s) => (
        <a href={s.href} target={s.href.startsWith('mailto:') ? undefined : '_blank'} rel={s.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'} style="color: var(--color-text-secondary); font-size: 14px; text-decoration: underline; text-underline-offset: 3px;">{s.label}</a>
      ))}
    </div>
  </div>
  <div style="max-width: 1152px; margin: 0 auto; padding: 16px 24px 32px; color: var(--color-text-secondary); font-size: 13px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
    <span>© {new Date().getFullYear()} {profile.name}. All rights reserved.</span>
    <span>Built as a static site with Astro · <a href="/sitemap-index.xml" style="color: inherit;">Sitemap</a></span>
  </div>
</footer>
