---
import { footerLinks } from '../data/navigation';
---
<footer class="no-print" style="border-top: 1px solid var(--color-border); margin-top: 4rem; padding: 3rem 0;">
  <div class="container" style="display: flex; flex-direction: column; gap: 1.5rem; border-top: 1px solid var(--color-border); padding-top: 2rem;">
    <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; align-items: center;">
      <div style="font-family: var(--font-serif); font-size: 1.25rem; font-weight: 500; letter-spacing: -0.03em; color: var(--color-text);">ANIRBAN CHATTERJEE</div>
      <div style="display: flex; gap: 1.5rem;">
        {footerLinks.socials.map((s) => (
          <a href={s.href} target={s.href.startsWith('mailto:') ? undefined : '_blank'} rel={s.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'} style="font-size: 0.9rem; color: var(--color-text-secondary); text-decoration: none;">{s.label}</a>
        ))}
      </div>
    </div>
    <p style="font-size: 0.85rem; color: var(--color-text-secondary); text-align: center;">© {new Date().getFullYear()} Anirban Chatterjee. All rights reserved.</p>
  </div>
</footer>
