---
import type { Achievement } from '../data/achievements';
interface Props { achievement: Achievement; }
const { achievement } = Astro.props;
---
<article class="card no-print" style="border-left: 3px solid var(--color-accent);">
  <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.75rem;">
    <h3 style="font-size: 1.125rem; margin: 0; letter-spacing: -0.01em;">{achievement.title}</h3>
    {achievement.impact && <span style="font-size: 0.875rem; font-weight: 700; color: var(--color-accent); white-space: nowrap;">{achievement.impact}</span>}
  </div>
  <p style="font-size: 0.875rem; color: var(--color-text-secondary); margin: 0.25rem 0 0.75rem 0;">{achievement.organization} · {achievement.year}</p>
  <p style="font-size: 0.95rem; color: var(--color-text-secondary); margin: 0 0 1rem 0;">{achievement.description}</p>
  <p style="font-size: 0.9rem; color: var(--color-text-secondary); margin: 0;"><strong style="color: var(--color-text);">Contribution:</strong> {achievement.contribution}</p>
  {achievement.measurementBasis && (
    <p style="font-size: 0.8rem; color: var(--color-text-secondary); margin-top: 0.5rem;">Basis: {achievement.measurementBasis}</p>
  )}
  <div style="margin-top: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
    {achievement.tags.map((tag) => (
      <span style="font-size: 0.75rem; color: var(--color-accent); border: 1px solid rgba(22, 58, 95, 0.2); padding: 0.2rem 0.5rem; border-radius: var(--radius-sm);">{tag}</span>
    ))}
  </div>
</article>
