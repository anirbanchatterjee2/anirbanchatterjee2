---
---
<div id="certificate-lightbox" class="no-print" role="dialog" aria-modal="true" aria-label="Certificate viewer" style="display: none; position: fixed; inset: 0; z-index: 200; background: rgba(0, 0, 0, 0.92);">
  <button type="button" id="lightbox-close" aria-label="Close certificate viewer" style="position: absolute; top: 1rem; right: 1.5rem; z-index: 10; background: transparent; border: none; color: #fff; font-size: 1.75rem; line-height: 1; cursor: pointer; padding: 0.5rem;">✕</button>
  <button type="button" id="lightbox-prev" aria-label="Previous image" style="position: absolute; top: 50%; left: 1rem; transform: translateY(-50%); z-index: 10; background: rgba(255,255,255,0.12); border: none; color: #fff; font-size: 1.75rem; line-height: 1; cursor: pointer; padding: 0.5rem 0.75rem; border-radius: var(--radius);">‹</button>
  <button type="button" id="lightbox-next" aria-label="Next image" style="position: absolute; top: 50%; right: 1rem; transform: translateY(-50%); z-index: 10; background: rgba(255,255,255,0.12); border: none; color: #fff; font-size: 1.75rem; line-height: 1; cursor: pointer; padding: 0.5rem 0.75rem; border-radius: var(--radius);">›</button>
  <div style="display: flex; align-items: center; justify-content: center; height: 100%; padding: 4rem 4.5rem 6rem;">
    <img id="lightbox-image" src="" alt="" style="display: none; max-width: 100%; max-height: 100%; object-fit: contain; border-radius: var(--radius); box-shadow: var(--shadow-lg); background: #fff;" />
    <embed id="lightbox-embed" src="" type="application/pdf" style="display: none; width: min(900px, 100%); height: 100%; border: none; border-radius: var(--radius); background: #fff;" />
  </div>
  <div style="position: absolute; bottom: 1.5rem; left: 0; right: 0; text-align: center; color: #fff; padding: 0 1.5rem;">
    <p id="lightbox-caption" style="font-size: 1rem; font-weight: 500; margin: 0;"></p>
    <p id="lightbox-org" style="font-size: 0.9rem; color: #cbd5e1; margin-top: 0.25rem;"></p>
    <p id="lightbox-count" style="font-size: 0.8rem; color: #94a3b8; margin-top: 0.25rem;"></p>
    <a id="lightbox-download" href="" download style="display: inline-block; margin-top: 0.75rem; color: #fff; text-decoration: underline; font-size: 0.9rem;">Download original</a>
  </div>
</div>
<script>
  type LightboxItem = { src: string; caption: string; org: string; downloadText?: string };

  const box = document.getElementById('certificate-lightbox');
  const imgEl = document.getElementById('lightbox-image') as HTMLImageElement | null;
  const embedEl = document.getElementById('lightbox-embed') as HTMLEmbedElement | null;
  const captionEl = document.getElementById('lightbox-caption');
  const orgEl = document.getElementById('lightbox-org');
  const countEl = document.getElementById('lightbox-count');
  const downloadEl = document.getElementById('lightbox-download') as HTMLAnchorElement | null;

  let items: LightboxItem[] = [];
  let index = 0;
  let lastTrigger: HTMLElement | null = null;

  function render() {
    if (!box || !imgEl || !embedEl || !captionEl || !orgEl || !countEl || !downloadEl) return;
    const item = items[index];
    if (!item) return;
    const isPdf = item.src.toLowerCase().endsWith('.pdf');
    imgEl.style.display = isPdf ? 'none' : 'block';
    embedEl.style.display = isPdf ? 'block' : 'none';
    if (isPdf) {
      embedEl.setAttribute('src', item.src);
      imgEl.removeAttribute('src');
    } else {
      imgEl.setAttribute('src', item.src);
      imgEl.setAttribute('alt', item.caption);
      embedEl.removeAttribute('src');
    }
    captionEl.textContent = item.caption;
    orgEl.textContent = item.org;
    countEl.textContent = items.length > 1 ? `Image ${index + 1} of ${items.length}` : '';
    downloadEl.setAttribute('href', item.src);
    downloadEl.textContent = item.downloadText ? `${item.downloadText} ↓` : 'Download original ↓';
    const prev = document.getElementById('lightbox-prev');
    const next = document.getElementById('lightbox-next');
    if (prev) prev.style.display = items.length > 1 ? 'block' : 'none';
    if (next) next.style.display = items.length > 1 ? 'block' : 'none';
  }

  function open(newItems: LightboxItem[], startIndex = 0, trigger?: HTMLElement | null) {
    if (!box) return;
    items = newItems;
    index = startIndex;
    lastTrigger = trigger ?? null;
    render();
    box.style.display = 'flex';
    document.getElementById('lightbox-close')?.focus();
    document.body.style.overflow = 'hidden';
  }

  function close() {
    if (!box) return;
    box.style.display = 'none';
    document.body.style.overflow = '';
    embedEl?.removeAttribute('src');
    imgEl?.removeAttribute('src');
    lastTrigger?.focus();
  }

  function step(delta: number) {
    if (items.length < 2) return;
    index = (index + delta + items.length) % items.length;
    render();
  }

  // Delegated trigger: any element with .lightbox-trigger and data-lightbox-images
  document.addEventListener('click', (e) => {
    const trigger = (e.target as HTMLElement | null)?.closest?.('.lightbox-trigger') as HTMLElement | null;
    if (!trigger) return;
    try {
      const parsed = JSON.parse(trigger.dataset.lightboxImages ?? '[]') as LightboxItem[];
      if (Array.isArray(parsed) && parsed.length > 0) open(parsed, 0, trigger);
    } catch {
      /* ignore malformed payload */
    }
  });

  document.getElementById('lightbox-close')?.addEventListener('click', close);
  document.getElementById('lightbox-prev')?.addEventListener('click', () => step(-1));
  document.getElementById('lightbox-next')?.addEventListener('click', () => step(1));
  box?.addEventListener('click', (e) => { if (e.target === box) close(); });

  document.addEventListener('keydown', (e) => {
    if (!box || box.style.display !== 'flex') return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });
</script>
