---
import type { Project } from '../lib/blog';
interface Props { project: Project; }
const { project } = Astro.props;
const slug = project.id.replace(/\.(md|mdx)$/, '');
const statusLabel = { 'concept': 'Concept', 'research': 'Research', 'in-development': 'In Development', 'prototype': 'Prototype', 'completed': 'Completed' }[project.data.status];
---
<article style="border-bottom: 1px solid var(--color-border); padding: 24px 0;">
  <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 8px; flex-wrap: wrap;">
    <span style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; border: 1px solid var(--color-border); padding: 3px 8px; border-radius: 999px; color: var(--color-text-secondary);">{statusLabel}</span>
    {project.data.startedYear && <span style="font-size: 13px; color: var(--color-text-secondary);">Started {project.data.startedYear}</span>}
  </div>
  <h3 style="font-size: 22px; margin-bottom: 8px;">
    <a href={`/projects/${slug}`} style="color: var(--color-text); text-decoration: none;">{project.data.name}</a>
  </h3>
  <p style="color: var(--color-text-secondary); max-width: 720px;">{project.data.description}</p>
  {project.data.techStack.length > 0 && (
    <p style="font-size: 13px; color: var(--color-text-secondary); margin-top: 8px;">{project.data.techStack.join(' · ')}</p>
  )}
  <p style="margin-top: 10px; display: flex; gap: 16px; flex-wrap: wrap;">
    <a href={`/projects/${slug}`} style="font-size: 14px; font-weight: 600; color: var(--color-accent); text-decoration: none;">View project →</a>
    {project.data.repoUrl && <a href={project.data.repoUrl} target="_blank" rel="noopener noreferrer" style="font-size: 14px; color: var(--color-text-secondary);">GitHub ↗</a>}
    {project.data.demoUrl && <a href={project.data.demoUrl} target="_blank" rel="noopener noreferrer" style="font-size: 14px; color: var(--color-text-secondary);">Demo ↗</a>}
  </p>
</article>
