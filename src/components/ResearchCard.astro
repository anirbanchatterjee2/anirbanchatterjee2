---
import type { ResearchProject } from '../data/research';
interface Props { project: ResearchProject; }
const { project } = Astro.props;
const statusClass = `badge badge-status badge-${project.status.toLowerCase().replace(/\s/g, '-')}`;
---
<article class="card no-print" style="border-left: 3px solid var(--color-accent-secondary);">
  <div style="aspect-ratio: 16/9; overflow: hidden; border-radius: var(--radius-sm); border: 1px solid var(--color-border); margin-bottom: 1rem; background: var(--color-muted-bg); position: relative;">
    {project.coverImage && (
      <img src={project.coverImage} alt={`Research: ${project.name}`} style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
    )}
    {!project.coverImage && (
      <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--color-text-secondary); font-size: 0.875rem;">Architecture diagram not yet uploaded</div>
    )}
    <span class={statusClass} style="position: absolute; top: 0.75rem; left: 0.75rem;">{project.status}</span>
  </div>
  <h3 style="font-size: 1.125rem; margin: 0 0 0.5rem 0; letter-spacing: -0.01em;">{project.name}</h3>
  <p style="font-size: 0.875rem; color: var(--color-text-secondary); margin: 0 0 0.5rem 0;">{project.category}</p>
  <p style="font-size: 0.9rem; color: var(--color-text-secondary); margin: 0 0 1rem 0;">{project.description}</p>
  <div style="margin-top: auto; display: flex; gap: 0.5rem; flex-wrap: wrap;">
    {project.techStack.map((t) => (
      <span style="font-size: 0.75rem; color: var(--color-text-secondary); border: 1px solid var(--color-border); padding: 0.2rem 0.5rem; border-radius: var(--radius-sm);">{t}</span>
    ))}
    <a href={`/research/${project.id}`} style="margin-left: auto; font-size: 0.85rem; color: var(--color-accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px;">Case study →</a>
  </div>
</article>
