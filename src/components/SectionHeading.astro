---
interface Props {
  title: string;
  subtitle?: string;
}
const { title, subtitle } = Astro.props;
---
<section class="section-rule" style="padding: 0 0 3rem 0;">
  <div style="display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 1rem;">
    <span style="display: inline-block; width: 3px; height: 1.25rem; background: var(--color-accent); border-radius: 2px;"></span>
    <h2 class="section-heading">{title}</h2>
  </div>
  {subtitle && <p class="section-subtitle">{subtitle}</p>}
</section>
