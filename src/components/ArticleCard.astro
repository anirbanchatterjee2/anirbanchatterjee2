---
import type { BlogPost } from '../lib/blog';
import { humanize } from '../lib/utils';
interface Props { post: BlogPost; }
const { post } = Astro.props;
const slug = post.id.replace(/\.(md|mdx)$/, '');
const wordCount = post.body.replace(/[#>*`\[\]()!|]/g, ' ').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(wordCount / 200));
---
<article class="card no-print">
  <div style="aspect-ratio: 16/9; overflow: hidden; border-radius: var(--radius-sm); border: 1px solid var(--color-border); margin-bottom: 1rem; background: var(--color-muted-bg); position: relative;">
    {post.data.coverImage && (
      <img src={post.data.coverImage} alt={"Cover: " + post.data.title} style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
    )}
  </div>
  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.75rem;">
    <span class="badge badge-category">{post.data.category}</span>
    <span style="font-size: 0.75rem; color: var(--color-text-secondary);">{post.data.pubDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })} · {readingTime} min read</span>
  </div>
  <h3 style="font-size: 1.125rem; margin: 0 0 0.5rem 0; letter-spacing: -0.01em;">
    <a href={"/blog/" + slug} style="color: var(--color-text); text-decoration: none;">{post.data.title}</a>
  </h3>
  <p style="color: var(--color-text-secondary); font-size: 0.95rem; margin: 0;">{post.data.description}</p>
</article>
