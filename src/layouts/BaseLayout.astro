---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import type { SeoProps } from '../lib/seo';
import { seoDefaults } from '../data/profile';
import { websiteJsonLd } from '../lib/seo';

interface Props extends SeoProps {
  jsonLd?: unknown;
}
const { jsonLd, ...seoProps } = Astro.props;
const pageScripts = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const scripts = [websiteJsonLd(), ...pageScripts];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <BaseHead {...seoProps} />
    {scripts.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Navigation />
    <main id="main" style="max-width: 1152px; margin: 0 auto; padding: 72px 1.5rem 0;">
      <slot />
    </main>
    <Footer />
  </body>
</html>
